# Copy to .env and run: node --env-file=.env src/dev.ts. All values are optional locally.
PORT=4000
DB_PATH=./data/platform.db
DEMO_NOW=2026-11-24T12:00:00Z
LOG_LEVEL=info
# 32 bytes, base64. Needed to keep webhook secrets and cursors valid across restarts.
MASTER_KEY=
# Kill switch, comma separated
DISABLED_AGENTS=
AGENT_CLIENT_SECRET=local-agent-secret
# Proxy hops in front of the API (a number), or their addresses. Never "true".
TRUST_PROXY=
CONSOLE_CLIENT_SECRET=local-console-secret
ACCESS_TTL_SECONDS=3600
