{
  "compilerOptions": {
    "target": "es2024", "module": "nodenext", "moduleResolution": "nodenext", "lib": ["es2024"],
    "types": ["node"], "strict": true, "noUncheckedIndexedAccess": true, "noEmit": true, "skipLibCheck": true,
    "allowImportingTsExtensions": true, "verbatimModuleSyntax": true, "erasableSyntaxOnly": true, "resolveJsonModule": true
  },
  "include": ["src", "mcp"]
}
